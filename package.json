{
  "name": "heuris-agent",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @heuris/api dev\" \"pnpm --filter @heuris/web dev\"",
    "build": "pnpm --filter @heuris/web build && pnpm --filter @heuris/api build",
    "start": "pnpm --filter @heuris/api start",
    "db:generate": "pnpm --filter @heuris/api db:generate",
    "db:migrate": "pnpm --filter @heuris/api db:migrate",
    "lint": "pnpm -r lint",
    "ts-check": "pnpm -r ts-check",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "only-allow": "^1.2.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=20"
  }
}
